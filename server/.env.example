# Copy this file to .env and fill in real values — see firebase-setup-and-testing.md

PORT=3000

# Comma-separated list of origins allowed to call this server.
# Your GitHub Pages URL, e.g. https://arthurswebdev-lang.github.io
ALLOWED_ORIGIN=https://arthurswebdev-lang.github.io

# Path to the Firebase service-account JSON key file (see setup doc).
# Never commit the actual key file.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
